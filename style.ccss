```css
/* =========================================
   STUDY HUB
   Modern Student Dashboard
   ========================================= */

/* 1. CSS VARIABLES */
:root {
    --primary: #6c63ff;
    --primary-dark: #554ce0;
    --primary-light: #eeecff;

    --background: #f7f8fc;
    --surface: #ffffff;

    --text-primary: #202236;
    --text-secondary: #777b91;
    --border: #eceef5;

    --success: #34b985;
    --warning: #ffb547;
    --danger: #ff6b81;

    --radius: 18px;
    --shadow: 0 8px 30px rgba(32, 34, 54, 0.05);

    --transition: all 0.25s ease;
}

/* 2. RESET */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 30px;
}

body {
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
    background: var(--background);
    color: var(--text-primary);
    line-height: 1.6;
    min-height: 100vh;
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    display: block;
    max-width: 100%;
}

ul {
    list-style: none;
}

/* 3. MAIN LAYOUT */
.app-container {
    display: flex;
    min-height: 100vh;
}

.main-content {
    flex: 1;
    min-width: 0;
    padding: 32px;
}

/* 4. SIDEBAR */
.sidebar {
    width: 250px;
    min-width: 250px;
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
    transition: var(--transition);
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 42px;
    padding: 0 10px;
}

.logo-icon {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--primary);
    color: white;
    font-size: 22px;
    font-weight: 800;
}

.logo h2 {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.7px;
}

.logo h2 span {
    color: var(--primary);
}

.sidebar-label {
    padding: 0 12px;
    margin-bottom: 12px;
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.nav-menu {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 14px;
    border-radius: 12px;
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 600;
    transition: var(--transition);
}

.nav-link:hover {
    background: #f7f6ff;
    color: var(--primary);
    transform: translateX(3px);
}

.nav-link.active {
    background: var(--primary-light);
    color: var(--primary);
}

.nav-icon {
    width: 22px;
    text-align: center;
    font-size: 18px;
}

.sidebar-bottom {
    margin-top: auto;
    padding-top: 35px;
}

.sidebar-card {
    padding: 18px;
    border-radius: 16px;
    background: linear-gradient(135deg, #6c63ff, #918aff);
    color: white;
}

.sidebar-card h3 {
    font-size: 15px;
    margin-bottom: 8px;
}

.sidebar-card p {
    font-size: 12px;
    line-height: 1.7;
    opacity: 0.9;
    margin-bottom: 15px;
}

.sidebar-card a {
    display: inline-block;
    background: white;
    color: var(--primary);
    padding: 8px 12px;
    border-radius: 9px;
    font-size: 12px;
    font-weight: 700;
}

/* 5. TOPBAR */
.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 35px;
}

.page-heading h1 {
    font-size: clamp(24px, 3vw, 30px);
    letter-spacing: -1px;
    font-weight: 800;
}

.page-heading p {
    color: var(--text-secondary);
    font-size: 14px;
    margin-top: 5px;
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 15px;
}

.search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 11px 15px;
    border-radius: 12px;
    width: 240px;
}

.search-box input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text-primary);
    font-size: 13px;
}

.search-box input::placeholder {
    color: #a1a4b5;
}

.icon-button {
    width: 43px;
    height: 43px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-primary);
    font-size: 18px;
    transition: var(--transition);
}

.icon-button:hover {
    background: var(--primary-light);
    color: var(--primary);
}

.profile {
    display: flex;
    align-items: center;
    gap: 10px;
}

.profile-avatar {
    width: 43px;
    height: 43px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--primary-light);
    color: var(--primary);
    font-weight: 800;
}

.profile-info h4 {
    font-size: 13px;
}

.profile-info p {
    color: var(--text-secondary);
    font-size: 11px;
}

/* 6. WELCOME BANNER */
.welcome-banner {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 35px;
    margin-bottom: 30px;
    border-radius: 22px;
    background: linear-gradient(120deg, #6c63ff, #887dff);
    color: white;
}

.welcome-banner::after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    right: 8%;
    top: -100px;
}

.welcome-banner::before {
    content: "";
    position: absolute;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.07);
    right: 2%;
    bottom: -90px;
}

.welcome-content {
    position: relative;
    z-index: 1;
}

.welcome-content .eyebrow {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    opacity: 0.85;
    margin-bottom: 10px;
}

.welcome-content h2 {
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.3;
    margin-bottom: 12px;
}

.welcome-content p {
    max-width: 460px;
    font-size: 14px;
    line-height: 1.8;
    opacity: 0.9;
}

.welcome-button {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 20px;
    background: white;
    color: var(--primary);
    border-radius: 12px;
    font-size: 13px;
    font-weight: 800;
    transition: var(--transition);
}

.welcome-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
}

/* 7. SECTION HEADER */
.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
}

.section-header h2 {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.4px;
}

.section-header p {
    color: var(--text-secondary);
    font-size: 13px;
    margin-top: 4px;
}

.text-link {
    color: var(--primary);
    font-size: 13px;
    font-weight: 700;
    transition: var(--transition);
}

.text-link:hover {
    color: var(--primary-dark);
}

/* 8. STATISTICS CARDS */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 35px;
}

.stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 22px;
    border-radius: var(--radius);
    transition: var(--transition);
}

.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.stat-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.stat-icon {
    width: 44px;
    height: 44px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 13px;
    font-size: 21px;
}

.stat-icon.purple {
    background: #eeecff;
    color: #6c63ff;
}

.stat-icon.green {
    background: #e4f8ef;
    color: #26a875;
}

.stat-icon.orange {
    background: #fff2df;
    color: #e89b2e;
}

.stat-icon.pink {
    background: #ffebf0;
    color: #ec6687;
}

.stat-badge {
    font-size: 11px;
    font-weight: 700;
    color: var(--success);
    background: #e9f9f1;
    padding: 5px 8px;
    border-radius: 8px;
}

.stat-card h3 {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -1px;
}

.stat-card p {
    color: var(--text-secondary);
    font-size: 12px;
    margin-top: 5px;
}

/* 9. GENERAL CARD */
.card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 25px;
    min-width: 0;
    box-shadow: 0 3px 15px rgba(32, 34, 54, 0.02);
}

.card + .card {
    margin-top: 20px;
}

/* 10. SUBJECT GRID */
.subject-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 35px;
}

.subject-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    transition: var(--transition);
}

.subject-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.subject-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
}

.subject-icon {
    width: 48px;
    height: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 14px;
    font-size: 23px;
}

.subject-icon.blue {
    background: #e8f1ff;
}

.subject-icon.purple {
    background: #eeecff;
}

.subject-icon.orange {
    background: #fff1df;
}

.subject-icon.green {
    background: #e4f8ef;
}

.subject-icon.pink {
    background: #ffebf0;
}

.subject-icon.yellow {
    background: #fff8d9;
}

.subject-tag {
    padding: 5px 9px;
    border-radius: 7px;
    background: #f3f4f9;
    color: var(--text-secondary);
    font-size: 10px;
    font-weight: 700;
}

.subject-card h3 {
    font-size: 16px;
    margin-bottom: 6px;
}

.subject-card > p {
    color: var(--text-secondary);
    font-size: 12px;
    margin-bottom: 20px;
}

.subject-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 15px;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 11px;
}

.subject-footer a {
    color: var(--primary);
    font-weight: 700;
}

/* 11. PROGRESS BAR */
.progress-info {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 12px;
}

.progress-info span:first-child {
    color: var(--text-secondary);
}

.progress-info span:last-child {
    color: var(--primary);
    font-weight: 800;
}

.progress-bar {
    width: 100%;
    height: 7px;
    overflow: hidden;
    background: #f0f1f7;
    border-radius: 20px;
}

.progress-fill {
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #6c63ff, #a49cff);
    transition: width 0.5s ease;
}

.progress-fill.green {
    background: linear-gradient(90deg, #34b985, #72dfb4);
}

.progress-fill.orange {
    background: linear-gradient(90deg, #ffb547, #ffd18b);
}

/* 12. TASKS */
.task-list {
    display: flex;
    flex-direction: column;
    gap: 13px;
}

.task-item {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 14px;
    background: #fafaff;
    border: 1px solid #f0f0f8;
    border-radius: 12px;
    transition: var(--transition);
}

.task-item:hover {
    background: #f5f4ff;
}

.task-checkbox {
    appearance: none;
    -webkit-appearance: none;
    flex-shrink: 0;
    width: 19px;
    height: 19px;
    border: 2px solid #d8daea;
    border-radius: 6px;
    cursor: pointer;
    position: relative;
    transition: var(--transition);
}

.task-checkbox:checked {
    background: var(--primary);
    border-color: var(--primary);
}

.task-checkbox:checked::after {
    content: "✓";
    position: absolute;
    color: white;
    font-size: 13px;
    font-weight: 800;
    top: -1px;
    left: 2px;
}

.task-content {
    flex: 1;
    min-width: 0;
}

.task-content h4 {
    font-size: 13px;
    font-weight: 700;
    transition: var(--transition);
}

.task-content p {
    font-size: 11px;
    color: var(--text-secondary);
    margin-top: 4px;
}

.task-item.completed .task-content h4 {
    text-decoration: line-through;
    color: #a0a3b5;
}

.task-item.completed {
    opacity: 0.7;
}

.task-priority {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 700;
    padding: 5px 8px;
    border-radius: 7px;
}

.task-priority.high {
    color: #e64d68;
    background: #ffebf0;
}

.task-priority.medium {
    color: #c7831b;
    background: #fff4df;
}

.task-priority.low {
    color: #23966a;
    background: #e6f8ef;
}

/* 13. BUTTONS */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: none;
    border-radius: 11px;
    padding: 12px 17px;
    font-size: 13px;
    font-weight: 700;
    transition: var(--transition);
}

.btn-primary {
    background: var(--primary);
    color: white;
}

.btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
}

.btn-secondary {
    background: var(--primary-light);
    color: var(--primary);
}

.btn-secondary:hover {
    background: #e0ddff;
}

.btn-outline {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
}

.btn-outline:hover {
    border-color: var(--primary);
    color: var(--primary);
}

/* 14. FORMS */
.form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 18px;
}

.form-group label {
    font-size: 13px;
    font-weight: 700;
}

.form-control {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 11px;
    outline: none;
    background: white;
    color: var(--text-primary);
    font-size: 13px;
    transition: var(--transition);
}

.form-control:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(108, 99, 255, 0.1);
}

.form-control::placeholder {
    color: #a1a4b5;
}

textarea.form-control {
    min-height: 120px;
    resize: vertical;
}

/* 15. SCHEDULE / TABLE */
.table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.schedule-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    white-space: nowrap;
}

.schedule-table th {
    padding: 15px;
    background: #fafaff;
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.7px;
}

.schedule-table td {
    padding: 17px 15px;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
}

.schedule-table tbody tr:hover {
    background: #fafaff;
}

.schedule-table tbody tr:last-child td {
    border-bottom: none;
}

.schedule-time {
    color: var(--primary);
    font-weight: 800;
}

.schedule-status {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 7px;
    font-size: 10px;
    font-weight: 700;
}

.schedule-status.upcoming {
    color: #a16a0d;
    background: #fff4df;
}

.schedule-status.done {
    color: #23966a;
    background: #e6f8ef;
}

/* 16. TWO-COLUMN LAYOUT */
.content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
    gap: 22px;
    margin-bottom: 30px;
    align-items: start;
}

.content-column {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
}

.content-column .card + .card {
    margin-top: 0;
}

/* 17. EMPTY STATE */
.empty-state {
    text-align: center;
    padding: 40px 20px;
}

.empty-state-icon {
    font-size: 42px;
    margin-bottom: 15px;
}

.empty-state h3 {
    font-size: 16px;
    margin-bottom: 8px;
}

.empty-state p {
    font-size: 13px;
    color: var(--text-secondary);
}

/* 18. QUICK LINKS */
.quick-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.quick-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px;
    border: 1px solid var(--border);
    border-radius: 13px;
    transition: var(--transition);
}

.quick-link:hover {
    border-color: var(--primary);
    background: #faf9ff;
    transform: translateY(-2px);
}

.quick-link-icon {
    width: 40px;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 11px;
    background: var(--primary-light);
    font-size: 19px;
}

.quick-link h4 {
    font-size: 12px;
}

.quick-link p {
    font-size: 10px;
    color: var(--text-secondary);
}

/* 19. NOTES */
.note-card {
    padding: 18px;
    border-radius: 13px;
    border-left: 4px solid var(--primary);
    background: #f8f7ff;
    margin-bottom: 12px;
}

.note-card h4 {
    font-size: 13px;
    margin-bottom: 7px;
}

.note-card p {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.8;
}

.note-date {
    display: block;
    margin-top: 10px;
    color: #9b9db0;
    font-size: 10px;
}

/* 20. FOOTER */
.footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 11px;
}

.footer strong {
    color: var(--primary);
}

/* 21. SCROLLBAR */
::-webkit-scrollbar {
    width: 7px;
    height: 7px;
}

::-webkit-scrollbar-track {
    background: #f3f4f9;
}

::-webkit-scrollbar-thumb {
    background: #d5d6e6;
    border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
    background: #b5b7d0;
}

/* 22. RESPONSIVE: TABLET */
@media (max-width: 1100px) {
    .sidebar {
        width: 220px;
        min-width: 220px;
    }

    .main-content {
        padding: 25px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .subject-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .search-box {
        width: 190px;
    }

    .content-grid {
        grid-template-columns: 1fr;
    }
}

/* 23. RESPONSIVE: SMALL TABLET */
@media (max-width: 800px) {
    .app-container {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        min-width: 0;
        padding: 15px 20px;
        border-right: none;
        border-bottom: 1px solid var(--border);
    }

    .logo {
        margin-bottom: 15px;
    }

    .nav-menu {
        flex-direction: row;
        overflow-x: auto;
        padding-bottom: 5px;
    }

    .nav-link {
        flex-shrink: 0;
        padding: 10px 12px;
    }

    .nav-link:hover {
        transform: none;
    }

    .sidebar-label,
    .sidebar-bottom {
        display: none;
    }

    .main-content {
        padding: 22px;
    }

    .topbar {
        align-items: flex-start;
    }

    .topbar-right {
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .profile-info {
        display: none;
    }
}

/* 24. RESPONSIVE: MOBILE */
@media (max-width: 600px) {
    .main-content {
        padding: 16px;
    }

    .topbar {
        flex-direction: column;
        align-items: stretch;
        gap: 18px;
        margin-bottom: 25px;
    }

    .topbar-right {
        width: 100%;
        justify-content: space-between;
        flex-wrap: nowrap;
        gap: 8px;
    }

    .search-box {
        flex: 1;
        min-width: 0;
        width: auto;
        padding: 10px;
    }

    .profile {
        flex-shrink: 0;
    }

    .welcome-banner {
        flex-direction: column;
        align-items: flex-start;
        padding: 25px 22px;
    }

    .welcome-content h2 {
        font-size: 25px;
    }

    .welcome-button {
        width: 100%;
    }

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .stat-card {
        padding: 16px;
    }

    .stat-card h3 {
        font-size: 24px;
    }

    .stat-icon {
        width: 38px;
        height: 38px;
        font-size: 18px;
    }

    .stat-badge {
        font-size: 9px;
        padding: 4px 6px;
    }

    .subject-grid {
        grid-template-columns: 1fr;
        gap: 13px;
    }

    .section-header {
        align-items: flex-start;
    }

    .section-header h2 {
        font-size: 17px;
    }

    .card {
        padding: 18px;
    }

    .quick-links {
        grid-template-columns: 1fr;
    }

    .task-item {
        padding: 12px 10px;
    }

    .task-priority {
        font-size: 9px;
    }

    .footer {
        flex-direction: column;
        align-items: flex-start;
    }
}

/* 25. ACCESSIBILITY */
button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
    outline: 3px solid rgba(108, 99, 255, 0.45);
    outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
    }
}
```

